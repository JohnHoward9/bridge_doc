1nt:"Strong NT" (p#3 15-17hcp s#4333|4432|5332|4441, 14-16hcp s#5422 4-s 4-h, 13-15hcp s#6322 4-s 4-h)
{ name f1NTResponses
	2c:"4M inv+ or 1-suited major bad suit with shortage or 1 suited minor FG or 22(54) FG" (p#2 4h 3-s 8+hcp, 4s 3-h 8+hcp, 6+h 12+hcp q#hh-h s#6331|7321|7330|8221|8320, 6+s 12+hcp q#hh-s s#6331|7321|7330|8221|8320, 6+c 10+hcp 3-s 3-h, 6+d 10+hcp 3-s 3-h, s#5422 4+d 4+c 10+hcp)
	{ name f1NT2C
		2d:"Forced"
		{ name f1NT2C2DResponses
			2h:"Spades inv+" (4+s 8+hcp [$M=s, $OM=h])
			{
				2s:"Forced" ->f1NTInvPlusOne4CardMajor
			} 
			2s:"1-suiter minor gf or 22(54) gf" (6+c 10+hcp, 6+d 10+hcp, s#5422 4+d 4+c 10+hcp)
			{
				2nt:"Forced"
				{
					3c:"Diamonds" (6+d [$m=d, $Om=c])
					{
						3d:"Forced" ->f1NTGFSingleSuitedMinor
					} 
					3d:"Minors" (s#5422 4+d 4+c 10+hcp) ?1
					~> "Clubs" (6+c [$m=c, $Om=d]) ->f1NTGFSingleSuitedMinor lastBid:3d
				}
			}
			~> "Hearts inv+" (4+h 8+hcp [$M=h, $OM=s]) ->f1NTInvPlusOne4CardMajor
			(dbl):"Diamonds" (5+d 6+hcp) ->f1NT2C2DResponses
